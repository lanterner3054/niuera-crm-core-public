# This file is a public placeholder template.
# Do not put real credentials in this file.
# Copy it to .env locally and fill values outside git.

# Email / IMAP settings
NIUERA_IMAP_HOST=imap.example.invalid
NIUERA_IMAP_PORT=993
NIUERA_IMAP_USER=example-user@example.invalid
NIUERA_IMAP_PASS=placeholder-password
NIUERA_EMAIL_WEBHOOK_URL=https://example.invalid/email-callback
NIUERA_PROCESSED_EMAILS_FILE=/tmp/example-processed-emails.txt

# Feishu placeholder settings
FEISHU_APP_ID=example-value
FEISHU_APP_SECRET=placeholder-token
FEISHU_OUTREACH_APP_TOKEN=placeholder-token
FEISHU_OUTREACH_PROSPECTS_TABLE_ID=example-value

# MCP server placeholder settings
MCP_PORT=3001
MCP_API_TOKEN=placeholder-token

# n8n placeholder settings
N8N_BASE_URL=https://example.invalid/n8n
N8N_API_KEY=placeholder-token

# Dify placeholder settings
DIFY_BASE_URL=https://example.invalid/dify
DIFY_ADMIN_API_KEY=placeholder-token

# File allowlist placeholder settings
FILE_ALLOWED_DIRS=/tmp/example-dir
